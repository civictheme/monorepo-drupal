{
  "baseUrl": "http://civictheme.docker.amazee.io",
  "runOnly": {
    "type": "tag",
    "values": ["wcag2a", "wcag2aa", "wcag21a", "wcag21aa", "wcag22aa"]
  },
  "scenarios": [
    {
      "name": "webform-test-fields",
      "path": "/form/civictheme-test-webform-fields",
      "include": [["main"]]
    },
    {
      "name": "webform-test-fields-error-state",
      "path": "/form/civictheme-test-webform-fields",
      "include": [["main"]],
      "actions": [
        { "type": "click", "selector": "[data-drupal-selector=edit-submit]" }
      ]
    },
    {
      "name": "contact",
      "path": "/form/contact",
      "include": [["main"]]
    },
    {
      "name": "enquiry",
      "path": "/enquiry",
      "include": [["main"]]
    },
    {
      "name": "enquiry-error-state",
      "path": "/enquiry",
      "include": [["main"]],
      "actions": [
        { "type": "click", "selector": "[data-drupal-selector=edit-actions-submit]" }
      ]
    },
    {
      "name": "feedback-step-1",
      "path": "/feedback",
      "include": [["main"]]
    },
    {
      "name": "feedback-step-2",
      "path": "/feedback",
      "include": [["main"]],
      "actions": [
        { "type": "fill", "selector": "#edit-name", "value": "Test User" },
        { "type": "fill", "selector": "#edit-email", "value": "test@example.com" },
        { "type": "fill", "selector": "#edit-message", "value": "Test message" },
        { "type": "click", "selector": "[data-drupal-selector=edit-actions-wizard-next]" }
      ]
    },
    {
      "name": "core-form-elements",
      "path": "/civictheme-core-form-elements",
      "include": [["main"]]
    },
    {
      "name": "demo-parking-permit",
      "path": "/form/civictheme-demo-parking-permit",
      "include": [["main"]]
    },
    {
      "name": "demo-parking-permit-error-state",
      "path": "/form/civictheme-demo-parking-permit",
      "include": [["main"]],
      "actions": [
        {
          "type": "click",
          "selector": "[data-drupal-selector=edit-submit]",
          "waitForSelector": ".ct-field-message"
        }
      ]
    },
    {
      "name": "demo-library-card",
      "path": "/form/civictheme-demo-library-card",
      "include": [["main"]]
    },
    {
      "name": "demo-library-card-error-state",
      "path": "/form/civictheme-demo-library-card",
      "include": [["main"]],
      "actions": [
        { "type": "click", "selector": "[data-drupal-selector=edit-submit]" }
      ]
    },
    {
      "name": "demo-report-issue",
      "path": "/form/civictheme-demo-report-issue",
      "include": [["main"]]
    },
    {
      "name": "demo-report-issue-error-state",
      "path": "/form/civictheme-demo-report-issue",
      "include": [["main"]],
      "actions": [
        { "type": "click", "selector": "[data-drupal-selector=edit-submit]" }
      ]
    },
    {
      "name": "demo-community-grant",
      "path": "/form/civictheme-demo-community-grant",
      "include": [["main"]]
    },
    {
      "name": "demo-community-grant-error-state",
      "path": "/form/civictheme-demo-community-grant",
      "include": [["main"]],
      "actions": [
        { "type": "click", "selector": "[data-drupal-selector=edit-wizard-next]" }
      ]
    },
    {
      "name": "demo-swim-enrolment",
      "path": "/form/civictheme-demo-swim-enrolment",
      "include": [["main"]]
    },
    {
      "name": "demo-swim-enrolment-error-state",
      "path": "/form/civictheme-demo-swim-enrolment",
      "include": [["main"]],
      "actions": [
        { "type": "click", "selector": "[data-drupal-selector=edit-wizard-next]" }
      ]
    }
  ]
}
