{#
/**
 * @file
 * CivicTheme range input (draft).
 *
 * Draft of a potential CivicTheme Range component, composed theme-side: the
 * control renders through civictheme:input (keeping the form element class
 * contract - ct-input, theme class, modifier classes) and is styled from the
 * theme stylesheet (assets/sass/form/_form-custom.scss) until a uikit
 * component exists.
 *
 * children carries webform's optional <output> element, which the
 * webform.element.range library positions against the control.
 *
 * @see https://github.com/civictheme/uikit/issues/1045
 */
#}

{% if civictheme_kind is defined %}
  {% set theme_class = 'ct-theme-%s'|format(theme|default('light')) %}
  {% set invalid_class = is_invalid|default(false) ? 'ct-range--is-invalid' : '' %}
  <div class="ct-range {{ theme_class }} {{ invalid_class }}">
    {% include 'civictheme:input' with {
      theme: theme|default('light'),
      is_invalid: is_invalid|default(false),
      attributes: attributes,
      modifier_class: ('ct-range__control ' ~ modifier_class|default(''))|trim,
    } only %}
    {{ children }}
    {% if attributes['min'] is not null and attributes['max'] is not null %}
      <span class="ct-range__limits" aria-hidden="true">
        <span class="ct-range__limit ct-range__limit--min">{{ attributes['min'] }}</span>
        <span class="ct-range__limit ct-range__limit--max">{{ attributes['max'] }}</span>
      </span>
    {% endif %}
  </div>
{% else %}
  <input{{ attributes }} />
  {{ children }}
{% endif %}
