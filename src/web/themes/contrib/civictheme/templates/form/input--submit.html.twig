{#
/**
 * @file
 * CivicTheme implementation to display a 'submit' input.
 */
#}

{% include 'civictheme:button' with {
  theme: theme|default('light'),
  type: type,
  kind: 'submit',
  text: value,
  attributes: attributes|without('type', 'value'),
  modifier_class: modifier_class|default(''),
} only %}
