# CivicTheme monorepo — environment overrides.
#
# Copy to .env on first checkout; .env is gitignored and loaded by
# docker compose AND ahoy (see `env: .env` in .ahoy.yml). Edit .env, not
# this file — .env.example is the canonical reference.
#
# Variables left empty or commented out fall back to the defaults wired
# into docker-compose.override.yml (mostly `${VAR:-default}` form).
#
# Salsa Hosting supplies most of these as platform variables in production;
# this file is for LOCAL development only.
#
# Naming scheme: SCAFFOLD_* = scaffold framework, QUANT_* = Salsa Hosting
# platform, DRUPAL_* = Drupal app, CIVICTHEME_* = this monorepo's provision
# variants, third-party prefixes (DB_*, MYSQL_*, GITHUB_*, SSMTP_*, …) kept
# verbatim.

# ── Project identity ─────────────────────────────────────────────────────────
# SCAFFOLD_PROJECT is THE name of this stack. It derives:
#   - the pygmy URL http://<project>.docker.amazee.io (`ahoy info`, `ahoy
#     login`, drush)
#   - the Docker namespace — containers, networks, and the `<project>_db_data`
#     volume holding the database (via `name:` in docker-compose.override.yml)
# A second stack of this project (a git worktree, or the govcms variant stack)
# changes this one line and nothing else.
SCAFFOLD_PROJECT=civictheme-monorepo
# QUANT_APP_NAME is the application name on Salsa Hosting. Only
# `ahoy download-db` reads it (host-side, via the qc CLI).
QUANT_APP_NAME=civictheme-monorepo-drupal

# How `ahoy info` / `ahoy login` display site URLs: pygmy | docker | both.
SCAFFOLD_DISPLAY_URL=both

# ── Salsa Hosting deploy routing ─────────────────────────────────────────────
# `local` means the container will not auto-deploy at start — you run
# `ahoy build` / `ahoy provision` yourself. Any other value marks a server, and
# /quant-entrypoint.d/02-post-deploy.sh runs the deploy steps.
QUANT_ENV_TYPE=local

# profile = drush site:install <profile|recipe-path> + drush deploy
# database = import db.sql + restore site UUID + drush deploy
SCAFFOLD_PROVISION_TYPE=profile

# Post-provision hooks (scripts/quant/post-provision.d/*.sh).
SCAFFOLD_POST_PROVISION_ENABLED=1
SCAFFOLD_POST_PROVISION_ON_ERROR=abort

# Install source for SCAFFOLD_PROVISION_TYPE=profile: a profile machine name
# (minimal, govcms) or a recipe path. The ahoy build-*/provision-* variant
# commands override this per-run.
DRUPAL_INSTALL_PROFILE=minimal

# Site-install metadata (used by drush site:install).
DRUPAL_SITE_NAME=CivicTheme Source
DRUPAL_SITE_EMAIL=p.civictheme@salsa.digital

# Which Salsa Hosting environment `ahoy download-db` pulls from. Host-side only.
# QUANT_BACKUP_ENV=production

# ── CivicTheme provision variants ────────────────────────────────────────────
# All consumed by scripts/quant/post-provision.d/ hooks. The ahoy
# build-*/provision-* commands set these per-run; the .env values are the
# defaults for a plain `ahoy build` / `ahoy provision`.
#
# Content profile the provision-content hook installs
# (empty = theme defaults; corporate | government | highereducation).
CIVICTHEME_CONTENT_PROFILE=
# 1 = don't create/activate the generated civictheme_demo sub-theme.
CIVICTHEME_SUBTHEME_ACTIVATION_SKIP=
# 1 = generate the sub-theme as a sibling of the base theme
# (web/themes/contrib/civictheme_demo) instead of web/themes/custom.
CIVICTHEME_INSTALL_SIBLING=
# 1 = skip creating generated test content.
CIVICTHEME_GENERATED_CONTENT_CREATE_SKIP=
# 1 = skip enabling admin/dev helper modules.
CIVICTHEME_ADDITIONAL_MODULES_ACTIVATION_SKIP=

# ── Variant build knobs (host-side, read by docker compose / ahoy only) ──────
# GovCMS composer manifest swap — exported per-run by `ahoy composer-govcms`
# and the build-govcms* commands. CI/local only; the deployed image is
# d11-only.
COMPOSER=
# PHP version for the app image build: 8.4 for d11 (default), 8.3 for the
# govcms stack. Host-side build arg — set it in the govcms stack's .env
# together with SCAFFOLD_PROJECT=civictheme-monorepo--govcms.
# PHP_VERSION=8.4

# ── Database ─────────────────────────────────────────────────────────────────
DB_HOST=db
DB_PORT=3306
DB_DATABASE=drupal
DB_USERNAME=drupal
DB_PASSWORD=drupal
# Local dev with MySQL 8 uses 0 (TLS off, self-signed cert). Production RDS
# uses 1. See the scaffold's docs/db-connection-tls.md.
DB_TLS_ENABLED=0

# ── Mail ─────────────────────────────────────────────────────────────────────
SCAFFOLD_MAILHOG_ENABLED=1
# In production, Salsa Hosting supplies SSMTP_* vars instead.

# ── Composer GitHub auth ─────────────────────────────────────────────────────
# Without a token Composer hits GitHub anonymously and is rate-limited —
# `composer install` can fail or stall on a fresh build. `gh auth token` after
# logging into the GitHub CLI is the easy way to get one.
GITHUB_TOKEN=

# ── Security ─────────────────────────────────────────────────────────────────
# A DEPLOYED environment must supply its own DRUPAL_HASH_SALT (Salsa Hosting
# platform variable); settings.php refuses to boot a server without one.
# Locally a derived value is used. Regenerate with: openssl rand -hex 32
DRUPAL_HASH_SALT=

# ── Debug ────────────────────────────────────────────────────────────────────
# Toggled by `ahoy debug`; entrypoint 01-xdebug.sh reads this.
SCAFFOLD_XDEBUG_ENABLED=0
# Toggled by `ahoy php-debug` — verbose PHP error pages, caches off.
# DRUPAL_DEBUG=1

# ── Host UID/GID (Linux bind-mount ownership) ────────────────────────────────
# See the scaffold docs — leave unset unless the user invoking ahoy is not the
# user that owns the tree.
# HOST_UID=
# HOST_GID=

# ── Compose layering ─────────────────────────────────────────────────────────
# COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml:docker-compose.local.yml

# ── Compose project name (escape hatch — normally leave this alone) ──────────
# Already derived from SCAFFOLD_PROJECT; see the scaffold docs before setting.
# COMPOSE_PROJECT_NAME=
