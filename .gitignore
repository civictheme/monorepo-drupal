# --- Local environment / data ---
/.env
!/.data/
/.data/*
!/.data/.gitkeep
/src/web/sites/default/files/
/src/web/sites/default/settings.local.php
/src/web/sites/default/services.local.yml

# --- Per-developer compose layering (opt-in) ---
/docker-compose.local.yml
/.ahoy.local.yml
# Legacy DrevOps local overrides — inert under the scaffold stack.
/.env.local

# --- Front-end build artefacts ---
# Anywhere: a theme's node_modules is never committed. The CivicTheme base
# theme manages its own build artefacts (components/, dist/, storybook-static/)
# via its own .gitignore.
node_modules/
/src/.logs/
/.logs/

# --- Composer / Drupal scaffold artefacts ---
/vendor/
/src/vendor/
/src/bin/
/src/web/core/
/src/web/modules/contrib/
/src/web/profiles/contrib/
/src/web/libraries/

# Contrib themes are Composer-managed, except CivicTheme — the product this
# monorepo exists to develop — which is committed.
/src/web/themes/contrib/*
!/src/web/themes/contrib/civictheme

# Custom themes are generated (civictheme_demo), never committed.
/src/web/themes/custom/*
!/src/web/themes/custom/.gitkeep

# Recipes: Composer-managed except the committed test-content recipe.
/src/recipes/*
!/src/recipes/civictheme_content_generated_static/

# Site configuration: installed from profile, so sync stays empty.
/src/config/sync/*
!/src/config/sync/.gitkeep

# Written by `composer drupal:scaffold`. This project commits a customised
# .htaccess, robots.txt, index.php, autoload.php and update.php (see
# extra.drupal-scaffold.file-mapping in composer.json).
/src/web/.csslintrc
/src/web/.eslintrc.json
/src/web/README.md
/src/web/INSTALL.txt
/src/web/example.gitignore
/src/web/modules/README.txt
/src/web/profiles/README.txt
/src/web/themes/README.txt
/src/web/sites/README.txt
/src/web/sites/development.services.yml
/src/web/sites/example.settings.local.php
/src/web/sites/example.sites.php
/src/web/autoload_runtime.php
/src/recipes/README.txt

# --- Default settings files, preserved for Functional tests ---
# (tracked: settings.php, services.yml, default.*, includes/ — everything else
# under sites/default is runtime state)
/src/web/sites/default/files/

# --- Test / tooling artefacts ---
.twig-cs-fixer.cache
/src/tests/behat/screenshots

# --- Backups ---
*.bak.*

# --- IDE / OS noise ---
/.idea/
/.vscode/
.DS_Store
Thumbs.db
