{#
/**
 * @file
 * CivicTheme implementation to display a webform markup element in a form.
 *
 * Webform markup elements carry a form_element theme wrapper but are display
 * content, not controls: render a plain wrapper instead of the Field
 * component. The content arrives already wrapped in the Basic Content
 * component by the webform html editor markup preprocess, so the wrapper adds
 * no second typography layer; its attributes and compat classes are kept so
 * webform states and conditional logic still target the wrapper.
 */
#}

<div class="ct-theme-{{ theme|default('light') }} {{ modifier_class|default('') }}" {{ attributes }}>{{ children }}</div>
