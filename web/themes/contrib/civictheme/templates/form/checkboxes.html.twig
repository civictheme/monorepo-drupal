{#
/**
 * @file
 * CivicTheme implementation to display a checkboxes group.
 *
 * Renders the group through the CivicTheme Field component (fieldset with
 * the legend first, then description and the core-rendered options via the
 * control slot) inside the element carrying the group id. The core composite
 * fieldset wrapper is reduced to a plain container in
 * fieldset--checkboxes.html.twig.
 */
#}

{% include 'civictheme:field' with {
  theme: theme|default('light'),
  type: type|default('checkbox'),
  title: title|default(''),
  title_display: title_display|default('visible'),
  orientation: orientation|default('vertical'),
  is_required: is_required|default(false),
  is_disabled: is_disabled|default(false),
  is_invalid: is_invalid|default(false),
  description: description|default(''),
  id: element_id|default(''),
  message: message|default(null),
  required_text: required_text|default(''),
  control: children,
  attributes: attributes,
  modifier_class: modifier_class|default(''),
} only %}
